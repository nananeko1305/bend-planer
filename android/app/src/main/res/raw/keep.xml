<?xml version="1.0" encoding="utf-8"?>
<!--
  Pushes are sent with title_loc_key/body_loc_key, so these strings are looked
  up by name at runtime and never referenced from code. Without this, resource
  shrinking removes them and the notification shows up empty.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/update_notification_title,@string/update_notification_body,@string/gig_new_title,@string/gig_changed_title,@string/gig_cancelled_title,@string/tip_entered_title,@string/gig_tomorrow_title,@string/gig_today_title,@string/tip_reminder_title,@string/report_title,@string/report_body,@string/member_added_title,@string/member_removed_title,@string/feedback_title,@drawable/ic_stat_notify" />
